# --- Supabase (région EU) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service-role : SERVEUR UNIQUEMENT (webhooks, worker). Ne jamais exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de Price (récurrents mensuels) créés dans le dashboard Stripe
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# --- Meta Ads (S2) ---
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0

# --- Chiffrement des tokens OAuth (32 octets base64) ---
# Générer : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Optionnel : secret dédié aux liens signés du portail client.
# Si absent, TOKEN_ENCRYPTION_KEY est utilisé.
# SHARE_TOKEN_SECRET=

# --- Brief quotidien (S3) ---
# Resend : envoi du brief par email
RESEND_API_KEY=
BRIEF_FROM_EMAIL=Reportly <brief@getreportly.fr>
# Secret du cron : Vercel Cron envoie `Authorization: Bearer <CRON_SECRET>`
# Générer : openssl rand -hex 32
CRON_SECRET=

# --- Rapport mensuel (S4) ---
# Synthèse rédigée par Claude (Haiku par défaut). Seuls des agrégats anonymisés sont envoyés.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
